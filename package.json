{
  "name": "floatnote",
  "version": "1.0.5",
  "description": "轻量桌面便签应用（FloatNote）：全局快捷键、置顶悬浮、透明窗口、剪贴板图片粘贴、标签与待办清单。",
  "main": "main/main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "node scripts/start.js",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\"",
    "dist": "node scripts/dist.js",
    "dist:win": "node scripts/dist.js --win",
    "dist:mac": "node scripts/dist.js --mac",
    "dist:linux": "node scripts/dist.js --linux",
    "release": "node scripts/release.js"
  },
  "author": "tian",
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "26.0.12",
    "playwright-core": "1.65.0"
  },
  "packageManager": "pnpm@10.28.0",
  "build": {
    "appId": "com.floatnote.app",
    "productName": "FloatNote",
    "copyright": "Copyright © 2026 tian",
    "directories": {
      "output": "release"
    },
    "files": [
      "main/**",
      "renderer/**",
      "assets/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FloatNote",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "deleteAppDataOnUninstall": false,
      "artifactName": "FloatNote-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "FloatNote-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icon-1024.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "assets/icon-512.png",
      "artifactName": "FloatNote-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ttzttztt",
        "repo": "FloatNote",
        "releaseType": "draft"
      }
    ]
  },
  "pnpm": {
    "overrides": {
      "@electron/node-gyp": "10.2.0-electron.1"
    }
  },
  "dependencies": {
    "electron-updater": "6.6.2"
  }
}
